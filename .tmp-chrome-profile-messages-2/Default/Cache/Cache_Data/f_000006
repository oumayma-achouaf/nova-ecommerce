adding: 0 13px;\r\n  border-radius: 9px;\r\n\r\n  color: #111;\r\n  background: #f3f2ef;\r\n}\r\n\r\n.admin-header__search input {\r\n  width: 100%;\r\n\r\n  border: 0;\r\n  outline: none;\r\n  background: transparent;\r\n\r\n  color: var(--admin-text);\r\n  font-size: 12px;\r\n}\r\n\r\n.admin-header__search input::placeholder {\r\n  color: #81837f;\r\n}\r\n\r\n.admin-header__right {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\r\n  gap: 18px;\r\n}\r\n\r\n.admin-header__notification {\r\n  position: relative;\r\n\r\n  width: 36px;\r\n  height: 36px;\r\n\r\n  display: grid;\r\n  place-items: center;\r\n\r\n  background: transparent;\r\n  cursor: pointer;\r\n}\r\n\r\n.admin-header__notification-dot {\r\n  position: absolute;\r\n  top: 5px;\r\n  right: 6px;\r\n\r\n  width: 7px;\r\n  height: 7px;\r\n\r\n  border: 1.5px solid #fff;\r\n  border-radius: 50%;\r\n  background: #7e5635;\r\n}\r\n\r\n.admin-header__divider {\r\n  width: 1px;\r\n  height: 24px;\r\n\r\n  background: #d8d5cf;\r\n}\r\n\r\n.admin-header__profile {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n\r\n  cursor: pointer;\r\n}\r\n\r\n.admin-header__avatar {\n  width: 40px;\n  height: 40px;\n\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  border-radius: 50%;\n\n  color: #fff;\n  background: linear-gradient(145deg, #394238, #8b867c);\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.admin-header__avatar span {\n  line-height: 1;\n}\n\r\n.admin-header__profile-text {\r\n  min-width: 115px;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.admin-header__profile-text strong {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n}\r\n\r\n.admin-header__profile-text span {\r\n  font-size: 11px;\r\n  color: #70736f;\r\n}\r\n\r\n/* =========================\r\n   DASHBOARD GENERAL\r\n========================= */\r\n\r\n.admin-dashboard {\n  width: 100%;\n  min-width: 0;\n  padding: 28px 30px 38px;\n}\n\r\n.dashboard-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-end;\r\n\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.dashboard-welcome {\r\n  margin: 0 0 4px;\r\n\r\n  font-size: 14px;\r\n  color: #41433f;\r\n}\r\n\r\n.dashboard-heading h1 {\r\n  margin: 0;\r\n\r\n  font-family: Georgia, 'Times New Roman', serif;\r\n  font-size: 38px;\r\n  font-weight: 500;\r\n  line-height: 1.05;\r\n}\r\n\r\n.dashboard-date-filter {\r\n  height: 43px;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 11px;\r\n\r\n  padding: 0 15px;\r\n\r\n  border: 1px solid #e3e0da;\r\n  border-radius: 9px;\r\n\r\n  color: #20221e;\r\n  background: #fff;\r\n\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.dashboard-date-filter__arrow {\r\n  margin-left: 9px;\r\n  font-size: 16px;\r\n}\r\n\r\n/* =========================\r\n   STATS\r\n========================= */\r\n\r\n.dashboard-stats {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.stat-card {\n  min-width: 0;\n  min-height: 86px;\n\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n\r\n  padding: 14px 16px;\r\n\r\n  border: 1px solid rgba(0, 0, 0, 0.025);\r\n  border-radius: 9px;\r\n\r\n  background: rgba(255, 255, 255, 0.88);\r\n  box-shadow: 0 3px 14px rgba(54, 51, 43, 0.025);\r\n}\r\n\r\n.stat-card__icon {\r\n  flex: 0 0 auto;\r\n\r\n  width: 60px;\r\n  height: 58px;\r\n\r\n  display: grid;\r\n  place-items: center;\r\n\r\n  border-radius: 9px;\r\n\r\n  color: #283128;\r\n  background: #eeece5;\r\n}\r\n\r\n.stat-card__content {\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.stat-card__top {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.stat-card__top strong {\n  min-width: 0;\n  white-space: nowrap;\n\n  font-family: Georgia, 'Times New Roman', serif;\n  font-size: 27px;\n  font-weight: 600;\n  line-height: 1;\n}\n\r\n.stat-card__growth {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  flex: 0 0 auto;\n  margin-left: auto;\n\r\n  white-space: nowrap;\r\n\r\n  font-size: 12px;\r\n  color: var(--admin-success);\r\n}\r\n\r\n.stat-card__bottom {\n  margin-top: 3px;\n\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.stat-card__bottom span {\n  min-width: 0;\n  font-size: 13px;\n  color: #484b47;\n  line-height: 1.2;\n}\n\n.stat-card__bottom small {\n  white-space: nowrap;\n  font-size: 10px;\n  color: #868883;\n  line-height: 1.2;\n}\n\n@media (max-width: 1450px) {\n  .stat-card {\n    gap: 14px;\n    padding-inline: 14px;\n  }\n}\n\n/* =========================\n   MAIN GRID\n========================= */\n\r\n.dashboard-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 2.15fr) minmax(300px, 1fr);\r\n  gap: 14px;\r\n}\r\n\r\n.dashboard-left,\r\n.dashboard-right {\r\n  min-width: 0;\r\n}\r\n\r\n.dashboard-left {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.dashboard-right {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.dashboard-card {\n  min-width: 0;\n  max-width: 100%;\n  border: 1px solid rgba(0, 0, 0, 0.025);\n  border-radius: 10px;\n\r\n  background: rgba(255, 255, 255, 0.88);\r\n  box-shadow: 0 3px 14px rgba(50, 47, 39, 0.02);\r\n}\r\n\r\n.dashboard-card__header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n}\r\n\r\n.dashboard-card h2,\r\n.dashboard-card__header h2 {\r\n  margin: 0;\r\n\r\n  font-family: Georgia, 'Times New Roman', serif;\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n}\r\n\r\n.dashboard-link {\r\n  padding: 0;\r\n\r\n  color: #343631;\r\n  background: transparent;\r\n\r\n  font-size: 11px;\r\n  text-decoration: underline;\r\n  cursor: pointer;\r\n}\r\n\r\n/* =========================\r\n   SALES CHART AREA\r\n========================= */\r\n\r\n.dashboard-sales-card {\r\n  min-height: 294px;\r\n  padding: 17px 18px 18px;\r\n}\r\n\r\n.sales-card__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n}\r\n\r\n.sales-card__legend {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.sales-card__legend span {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n\r\n  font-size: 11px;\r\n  color: #6b6e69;\r\n}\r\n\r\n.legend-dot {\r\n  display: inline-block;\r\n\r\n  width: 9px;\r\n  height: 9px;\r\n\r\n  border-radius: 50%;\r\n}\r\n\r\n.legend-dot--current {\r\n  background: #43503f;\r\n}\r\n\r\n.legend-dot--previous {\r\n  background: #bfc0ba;\r\n}\r\n\r\n.sales-card__actions select {\r\n  height: 36px;\r\n  padding: 0 36px 0 12px;\r\n\r\n  border: 1px solid #e1dfd9;\r\n  border-radius: 8px;\r\n\r\n  outline: none;\r\n  background: #fff;\r\n\r\n  font-size: 11px;\r\n}\r\n\r\n/* =========================\n   SALES DISTRIBUTION\n========================= */\n\r\n.sales-distribution {\r\n  padding: 17px 18px;\r\n}\r\n\r\n.sales-distribution__content {\r\n  min-height: 145px;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 18px;\r\n\r\n  margin-top: 14px;\r\n}\r\n\r\n.donut-chart {\r\n  position: relative;\r\n\r\n  width: 145px;\r\n  height: 145px;\r\n\r\n  flex: 0 0 145px;\r\n\r\n  border-radius: 50%;\r\n\r\n  background:\r\n    conic-gradient(\r\n      #485143 0 68%,\r\n      #aaa899 68% 90%,\r\n      #d5cfbf 90% 100%\r\n    );\r\n}\r\n\r\n.donut-chart::after {\r\n  content: '';\r\n\r\n  position: absolute;\r\n  inset: 20px;\r\n\r\n  border-radius: 50%;\r\n  background: #fff;\r\n}\r\n\r\n.donut-chart__center {\r\n  position: absolute;\r\n  z-index: 2;\r\n  inset: 0;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.donut-chart__center strong {\r\n  font-family: Georgia, 'Times New Roman', serif;\r\n  font-size: 15px;\r\n}\r\n\r\n.donut-chart__center span {\r\n  margin-