: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 12px;\r\n  width: 100%;\r\n  min-height: 48px;\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.cart-checkout-button {\r\n  margin-bottom: 10px;\r\n  background: #111;\r\n  color: #fff;\r\n}\r\n\r\n.cart-checkout-button:hover {\r\n  background: #262626;\r\n}\r\n\r\n.cart-continue-button {\r\n  border: 1px solid #77736e;\r\n  background: transparent;\r\n  color: #111;\r\n}\r\n\r\n.cart-summary-benefits {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  margin-top: 22px;\r\n  padding-top: 18px;\r\n  border-top: 1px solid #e5e0d9;\r\n}\r\n\r\n.cart-summary-benefits > div {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 9px;\r\n  min-width: 0;\r\n  padding: 0 9px;\r\n  color: #65615d;\r\n  font-size: 9px;\r\n  line-height: 1.2;\r\n}\r\n\r\n.cart-summary-benefits > div + div {\r\n  border-left: 1px solid #ddd8d0;\r\n}\r\n\r\n/* =========================================================\r\n   RECOMMENDATIONS\r\n========================================================= */\r\n\r\n.cart-recommendations {\r\n  width: 100%;\r\n  margin-top: 24px;\r\n}\r\n\r\n.cart-recommendations-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 18px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.cart-recommendations-heading h2 {\r\n  margin: 0;\r\n  font-family: \"Cormorant Garamond\", serif;\r\n  font-size: 27px;\r\n  font-weight: 600;\r\n}\r\n\r\n.cart-recommendations-heading a {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  color: #111;\r\n  font-size: 10px;\r\n  text-decoration: underline;\r\n}\r\n\r\n.cart-recommendation-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 14px;\r\n  width: 100%;\r\n}\r\n\r\n.cart-recommendation-card {\r\n  display: grid;\r\n  grid-template-columns: 46% minmax(0, 1fr);\r\n  min-width: 0;\r\n  mi