epeat(2, minmax(0, 1fr));\r\n  }\r\n\r\n  .reviews-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 650px) {\r\n  .product-main {\r\n    gap: 28px;\r\n  }\r\n\r\n  .product-gallery {\r\n    display: flex;\r\n    flex-direction: column-reverse;\r\n  }\r\n\r\n  .product-thumbnails {\r\n    flex-direction: row;\r\n    overflow-x: auto;\r\n    padding-bottom: 4px;\r\n  }\r\n\r\n  .product-thumbnail {\r\n    flex: 0 0 64px;\r\n  }\r\n\r\n  .product-main-image,\r\n  .product-main-image img {\r\n    min-height: 420px;\r\n  }\r\n\r\n  .product-info-top {\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .product-reference {\r\n    justify-content: flex-end;\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .product-size-header {\r\n    align-items: flex-start;\r\n    gap: 15px;\r\n  }\r\n\r\n  .product-size-list {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .product-actions-row {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .product-quantity-block {\r\n    max-width: 130px;\r\n  }\r\n\r\n  .product-benefits {\r\n    grid-template-columns: 1fr 1fr;\r\n  }\r\n\r\n  .product-tab-buttons {\r\n    gap: 17px;\r\n    overflow-x: auto;\r\n  }\r\n\r\n  .similar-products-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* =========================================================\r\n   CART PAGE\r\n========================================================= */\r\n\r\n.cart-page {\r\n  min-height: calc(100vh - 72px);\r\n  padding: 24px 0 0;\r\n  background: #faf8f4;\r\n}\r\n\r\n.cart-page .nova-container {\r\n  width: min(1180px, calc(100% - 48px));\r\n  margin-inline: auto;\r\n}\r\n\r\n.cart-breadcrumb {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 14px;\r\n  color: #7c7770;\r\n  font-size: 11px;\r\n}\r\n\r\n.cart-breadcrumb a {\r\n  color: inherit;\r\n}\r\n\r\n.cart-breadcrumb a:hover {\r\n  color: #111;\r\n}\r\n\r\n.cart-layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 360px;\r\n  gap: 28px;\r\